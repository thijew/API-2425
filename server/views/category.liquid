<h1>Categorie: {{ selectedCategory.name }}</h1>

<ul>
  {% for item in items %}
    <li>
      <img src="{{ item.icon }}" alt="{{ item.name }}">
      {{ item.name }}
      Type: {{ item.type }}
    </li>
  {% endfor %}
</ul>

<a href="/">← Terug naar alle categorieën</a>
<ul>
  {% for cat in categories %}
    <li><a href="/category/{{ cat.id }}">  {% endfor %}
    {% for item in items %} {{ item.name }}</a></li>  {% endfor %}
 
</ul>
<a href="/category/:id/:letter?"> See more items</a>
