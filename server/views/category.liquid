{% layout "server/layouts/base.liquid" %}

{% block content %}

<h1>{{ title }}</h1>
<ul>
  {% for item in items %}
    <li>
      <img src="{{ item.icon_large }}" alt="{{ item.name }} icon" />
      <strong>{{ item.name }}</strong> – {{ item.price }} gp
    </li>
  {% endfor %}
</ul>

<a href="/">← Terug naar alle categorieën</a>

{% endblock %}