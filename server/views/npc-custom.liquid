<h1>{{ title }}</h1>

<form method="get" action="/npc/custom">
  <label for="name">NPC of Player name:</label>
  <input type="text" name="name" id="name" required placeholder="Hans of Zezima" />

  <label for="appearance">Appearance string:</label>
  <input type="text" name="appearance" id="appearance" required placeholder="AP--AAA-----------------" />

  <button type="submit">Bekijk avatar</button>
</form>

{% if showResult %}
  <hr />
  <h2>Resultaat voor {{ npcName }}</h2>
  <img src="{{ imageUrl }}" alt="Avatar van {{ npcName }}" width="128" height="128" />
  <p><strong>Appearance string:</strong> {{ appearance }}</p>

  <h3>Worn Items</h3>
  <ul>
    {% if wornItems.length == 0 %}
      <li><em>Geen zichtbare uitrusting.</em></li>
    {% else %}
      {% for item in wornItems %}
        <li>{{ item }}</li>
      {% endfor %}
    {% endif %}
  </ul>
{% endif %}

<a href="/">← Terug naar homepage</a>
